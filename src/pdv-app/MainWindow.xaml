<Window x:Class="PdvLocal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PDV Local"
        WindowState="Maximized"
        MinHeight="680"
        MinWidth="1040"
        Background="{DynamicResource WindowBackground}"
        Loaded="Window_Loaded"
        KeyDown="MainWindow_KeyDown">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SettingsButton"
                        Content="Configurações"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="SettingsButton_Click"
                        Margin="0,0,8,0" />
                <Button x:Name="HelpButton"
                        Content="F1 Ajuda"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="HelpButton_Click"
                        Margin="0,0,8,0" />
                <Button x:Name="CashButton"
                        Content="F4 Caixa"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CashButton_Click"
                        Margin="0,0,8,0" />
                <Button x:Name="SwitchOperatorButton"
                        Content="F11 Operador"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="SwitchOperatorButton_Click"
                        Margin="0,0,8,0" />
                <Button x:Name="ReprintButton"
                        Content="Reimprimir"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="ReprintButton_Click"
                        Visibility="Collapsed"
                        Margin="0,0,8,0" />
                <Button x:Name="CashSalesButton"
                        Content="Vendas do caixa"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CashSalesButton_Click"
                        IsEnabled="False"
                        Margin="0,0,8,0" />
                <Button x:Name="RefreshButton"
                        Content="Atualizar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RefreshButton_Click"
                        Margin="0,0,8,0" />
                <Button x:Name="OpenSetupButton"
                        Content="Ativacao"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OpenSetupButton_Click" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="PDV Local"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="Frente de caixa local"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="14"
                           Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                x:Name="BannerBorder"
                Background="{DynamicResource AccentBg}"
                BorderBrush="{DynamicResource AccentBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,18,0,14">
            <TextBlock x:Name="BannerText"
                       Text="Carregando status do SyncAgent..."
                       Foreground="{DynamicResource AccentText}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <Border x:Name="OperatorsImportPanel" Style="{StaticResource CardStyle}" Margin="0,0,12,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Operadores"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Nenhum operador foi importado do ERP ainda. O PDV Local nao cria usuarios manualmente; os operadores devem vir do ERP por sincronizacao."
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="SalePanel" Style="{StaticResource CardStyle}" Margin="0,0,12,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="220" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="NewSaleButton"
                                            Content="Nova venda"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="NewSaleButton_Click"
                                            Margin="0,0,8,0" />
                                    <Button x:Name="RemoveItemButton"
                                            Content="Remover item"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Click="RemoveItemButton_Click" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="SaleTitleValue"
                                               Text="Venda"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock x:Name="SaleGateValue"
                                               Text="Abra um caixa para liberar a venda."
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Produto: ID, SKU, codigo de barras ou nome" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="ProductEntryTextBox"
                                             Style="{StaticResource InputStyle}"
                                             FontSize="18"
                                             KeyDown="ProductEntryTextBox_KeyDown" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Qtd" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="QuantityTextBox" Style="{StaticResource InputStyle}" Text="1" TextChanged="SaleInputTextChanged" KeyDown="QuantityTextBox_KeyDown" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Preco" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="UnitPriceTextBox" Style="{StaticResource InputStyle}" IsReadOnly="True" IsTabStop="False" Text="0,00" />
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Desc. item" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="ItemDiscountTextBox" Style="{StaticResource InputStyle}" Text="0,00" TextChanged="SaleInputTextChanged" KeyDown="ItemDiscountTextBox_KeyDown" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Total item" Style="{StaticResource LabelStyle}" />
                                    <TextBlock x:Name="SelectedProductTotalValue"
                                               Text="R$ 0,00"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               Margin="0,8,10,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                    <Button x:Name="ProductSearchButton"
                                            Content="Buscar"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ProductSearchButton_Click"
                                            Margin="0,0,8,0" />
                                    <Button x:Name="AddItemButton"
                                            Content="Adicionar"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="AddItemButton_Click" />
                                </StackPanel>
                            </Grid>

                            <DataGrid Grid.Row="2"
                                      x:Name="ProductSearchResultsGrid"
                                      MaxHeight="180"
                                      Margin="0,0,0,10"
                                      MouseDoubleClick="ProductSearchResultsGrid_MouseDoubleClick"
                                      KeyDown="ProductSearchResultsGrid_KeyDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Codigo" Binding="{Binding DisplayCode}" Width="130" />
                                    <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Un" Binding="{Binding Unit}" Width="55" />
                                    <DataGridTextColumn Header="Preco" Binding="{Binding PriceText}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <DataGrid Grid.Row="3"
                                      x:Name="CartItemsGrid"
                                      Margin="0,0,0,10"
                                      KeyDown="CartItemsGrid_KeyDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="45" />
                                    <DataGridTextColumn Header="Codigo" Binding="{Binding DisplayCode}" Width="120" />
                                    <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Qtd" Binding="{Binding QuantityText}" Width="70" />
                                    <DataGridTextColumn Header="Unit." Binding="{Binding UnitPriceText}" Width="85" />
                                    <DataGridTextColumn Header="Desc." Binding="{Binding DiscountAmountText}" Width="85" />
                                    <DataGridTextColumn Header="Total" Binding="{Binding TotalAmountText}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mensagem" Style="{StaticResource LabelStyle}" />
                                    <TextBlock x:Name="OperationMessageValue"
                                               Text="-"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Subtotal" Style="{StaticResource LabelStyle}" />
                                    <TextBlock x:Name="SubtotalValue" Text="R$ 0,00" Style="{StaticResource ValueStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Desc. total" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="SaleDiscountTextBox"
                                             Style="{StaticResource InputStyle}"
                                             Text="0,00"
                                             TextChanged="SaleDiscountTextBox_TextChanged" />
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Total" Style="{StaticResource LabelStyle}" />
                                    <TextBlock x:Name="TotalValue"
                                               Text="R$ 0,00"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="26"
                                               FontWeight="Bold" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Pagamento"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="0,0,0,10" />

                            <TextBlock Text="Especie" Style="{StaticResource LabelStyle}" />
                            <ComboBox x:Name="PaymentMethodComboBox"
                                      IsEditable="True"
                                      DisplayMemberPath="DisplayName"
                                      TextSearch.TextPath="Name"
                                      Margin="0,0,10,8"
                                      Padding="8,6" />

                            <TextBlock Text="Condicao" Style="{StaticResource LabelStyle}" />
                            <ComboBox x:Name="PaymentConditionComboBox"
                                      IsEditable="True"
                                      DisplayMemberPath="DisplayName"
                                      TextSearch.TextPath="Name"
                                      Margin="0,0,10,8"
                                      Padding="8,6" />

                            <TextBlock Text="Valor recebido" Style="{StaticResource LabelStyle}" />
                            <TextBox x:Name="PaymentReceivedTextBox" Style="{StaticResource InputStyle}" Text="0,00"
                                     KeyDown="PaymentReceivedTextBox_KeyDown"
                                     GotFocus="PaymentReceivedTextBox_GotFocus" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="AddPaymentButton"
                                        Content="Adicionar"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="AddPaymentButton_Click"
                                        Margin="0,0,8,0" />
                                <Button x:Name="RemovePaymentButton"
                                        Content="Remover"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="RemovePaymentButton_Click" />
                            </StackPanel>

                            <DataGrid x:Name="PaymentsGrid" MaxHeight="160" Margin="0,0,0,10" KeyDown="PaymentsGrid_KeyDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Especie" Binding="{Binding Method}" Width="*" />
                                    <DataGridTextColumn Header="Condicao" Binding="{Binding Condition}" Width="95" />
                                    <DataGridTextColumn Header="Aplicado" Binding="{Binding AmountText}" Width="82" />
                                    <DataGridTextColumn Header="Troco" Binding="{Binding ChangeAmountText}" Width="72" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Pago" Style="{StaticResource LabelStyle}" />
                                    <TextBlock x:Name="PaidValue" Text="R$ 0,00" Style="{StaticResource ValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Restante" Style="{StaticResource LabelStyle}" />
                                    <TextBlock x:Name="RemainingValue" Text="R$ 0,00" Style="{StaticResource ValueStyle}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Troco" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="ChangeValue"
                                       Text="R$ 0,00"
                                       Foreground="{DynamicResource SuccessText}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12" />

                            <Button x:Name="CompleteSaleButton"
                                    Content="Finalizar venda"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="CompleteSaleButton_Click" />
                        </StackPanel>
                    </Border>

                    <Expander Header="Detalhes tecnicos" IsExpanded="False" Margin="0,0,0,12">
                        <StackPanel>
                            <UniformGrid Columns="5" Margin="0,8,0,0">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Ativacao" Style="{StaticResource LabelStyle}" />
                                        <TextBlock x:Name="ProvisioningValue" Text="-" Style="{StaticResource ValueStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Runtime" Style="{StaticResource LabelStyle}" />
                                        <TextBlock x:Name="RuntimeValue" Text="-" Style="{StaticResource ValueStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Pendentes" Style="{StaticResource LabelStyle}" />
                                        <TextBlock x:Name="PendingValue" Text="-" Style="{StaticResource ValueStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Dead-letter" Style="{StaticResource LabelStyle}" />
                                        <TextBlock x:Name="DeadLetterValue" Text="-" Style="{StaticResource ValueStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Caixas abertos" Style="{StaticResource LabelStyle}" />
                                        <TextBlock x:Name="OpenCashSessionsValue" Text="-" Style="{StaticResource ValueStyle}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource CardStyle}" Margin="0,8,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Versao PDV" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AppVersionValue" Text="-" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Heartbeat" Style="{StaticResource LabelStyle}" Margin="0,10,0,5" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="HeartbeatValue" Text="-" TextWrapping="Wrap" Margin="0,10,0,0" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="pgvector" Style="{StaticResource LabelStyle}" Margin="0,10,0,5" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PgVectorValue" Text="-" TextWrapping="Wrap" Margin="0,10,0,0" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Schema PDV" Style="{StaticResource LabelStyle}" Margin="0,10,0,5" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="PdvSchemaValue" Text="-" TextWrapping="Wrap" Margin="0,10,0,0" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Operadores" Style="{StaticResource LabelStyle}" Margin="0,10,0,5" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="OperatorsValue" Text="-" TextWrapping="Wrap" Margin="0,10,0,0" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Produtos" Style="{StaticResource LabelStyle}" Margin="0,10,0,5" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ProductsValue" Text="-" TextWrapping="Wrap" Margin="0,10,0,0" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Vendas" Style="{StaticResource LabelStyle}" Margin="0,10,0,5" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="SalesValue" Text="-" TextWrapping="Wrap" Margin="0,10,0,0" />

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Instalacao" Style="{StaticResource LabelStyle}" Margin="0,10,0,5" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" x:Name="InstanceValue" Text="-" TextWrapping="Wrap" Margin="0,10,0,0" />

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="ERP API" Style="{StaticResource LabelStyle}" Margin="0,10,0,5" />
                                    <TextBlock Grid.Row="8" Grid.Column="1" x:Name="ErpApiValue" Text="-" TextWrapping="Wrap" Margin="0,10,0,0" />

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Banco local" Style="{StaticResource LabelStyle}" Margin="0,10,0,5" />
                                    <TextBlock Grid.Row="9" Grid.Column="1" x:Name="DatabaseValue" Text="-" TextWrapping="Wrap" Margin="0,10,0,0" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Tenant ERP" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TenantValue" Text="-" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ultimo erro" Style="{StaticResource LabelStyle}" Margin="0,10,0,5" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LastErrorValue" Text="-" TextWrapping="Wrap" Margin="0,10,0,0" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Erro banco" Style="{StaticResource LabelStyle}" Margin="0,10,0,5" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DatabaseErrorValue" Text="-" TextWrapping="Wrap" Margin="0,10,0,0" />
                                </Grid>
                            </Border>

                            <Button x:Name="CheckUpdateButton"
                                    Content="Verificar atualização"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,8,0,0"
                                    Padding="14,8"
                                    HorizontalAlignment="Left"
                                    Click="CheckUpdateButton_Click"
                                    ToolTip="Solicita ao Sync Agent que consulte o ERP por uma atualização disponível" />
                            <TextBlock x:Name="CheckUpdateStatusText"
                                       Text=""
                                       FontSize="12"
                                       Foreground="{DynamicResource StatusText}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="True">
            <TextBlock x:Name="OperatorStatusText"
                       DockPanel.Dock="Left"
                       Text="Operador: -"
                       Foreground="{DynamicResource TextPrimary}"
                       FontWeight="SemiBold"
                       FontSize="12"
                       Margin="0,0,18,0" />
            <TextBlock x:Name="CashStatusText"
                       DockPanel.Dock="Left"
                       Text="Caixa: fechado — F4 para abrir"
                       Foreground="{DynamicResource TextPrimary}"
                       FontWeight="SemiBold"
                       FontSize="12"
                       Margin="0,0,18,0" />
            <TextBlock x:Name="FooterText"
                       Text="Aguardando status."
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="12"
                       TextAlignment="Right" />
        </DockPanel>

        <TextBlock x:Name="LocalApiValue" Visibility="Collapsed" />
    </Grid>
</Window>
