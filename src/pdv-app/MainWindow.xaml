<Window x:Class="PdvLocal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PDV Local"
        WindowState="Maximized"
        MinHeight="680"
        MinWidth="1040"
        Background="{DynamicResource WindowBackground}"
        Loaded="Window_Loaded"
        KeyDown="MainWindow_KeyDown">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="HelpButton"
                        Content="F1 Ajuda"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="HelpButton_Click"
                        Margin="0,0,8,0" />
                <Button x:Name="PriceCheckButton"
                        Content="F3 Preço"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="PriceCheckButton_Click"
                        Margin="0,0,8,0" />
                <Button x:Name="CashButton"
                        Content="F4 Caixa"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CashButton_Click"
                        Margin="0,0,8,0" />
                <Button x:Name="CashSalesButton"
                        Content="F8 Vendas"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CashSalesButton_Click"
                        IsEnabled="False"
                        Margin="0,0,8,0" />
                <Button x:Name="ReprintButton"
                        Content="F9 Reimprimir"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="ReprintButton_Click"
                        Visibility="Collapsed"
                        Margin="0,0,8,0" />
                <Button x:Name="SwitchOperatorButton"
                        Content="F11 Operador"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="SwitchOperatorButton_Click"
                        Margin="0,0,8,0" />
                <Button x:Name="SettingsButton"
                        Content="Configurações"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="SettingsButton_Click" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="PDV Local"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="Frente de caixa local"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="13" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                x:Name="BannerBorder"
                Background="{DynamicResource AccentBg}"
                BorderBrush="{DynamicResource AccentBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,12,0,10">
            <TextBlock x:Name="BannerText"
                       Text="Carregando status do SyncAgent..."
                       Foreground="{DynamicResource AccentText}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="OperatorsImportPanel" Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Operadores"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Nenhum operador foi importado do ERP ainda. O PDV Local nao cria usuarios manualmente; os operadores devem vir do ERP por sincronizacao."
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border x:Name="SalePanel" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="NewSaleButton"
                                            Content="Nova venda"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="NewSaleButton_Click"
                                            Margin="0,0,8,0" />
                                    <Button x:Name="RemoveItemButton"
                                            Content="Remover item"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Click="RemoveItemButton_Click" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="SaleTitleValue"
                                               Text="Venda"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock x:Name="SaleGateValue"
                                               Text="Abra um caixa para liberar a venda."
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Produto: ID, SKU, codigo de barras ou nome" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="ProductEntryTextBox"
                                             Style="{StaticResource InputStyle}"
                                             FontSize="18"
                                             KeyDown="ProductEntryTextBox_KeyDown" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Qtd" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="QuantityTextBox" Style="{StaticResource InputStyle}" Text="1" TextChanged="SaleInputTextChanged" KeyDown="QuantityTextBox_KeyDown" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Preco" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="UnitPriceTextBox" Style="{StaticResource InputStyle}" IsReadOnly="True" IsTabStop="False" Text="0,00" />
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Desc. item" Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="ItemDiscountTextBox" Style="{StaticResource InputStyle}" Text="0,00" TextChanged="SaleInputTextChanged" KeyDown="ItemDiscountTextBox_KeyDown" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Total item" Style="{StaticResource LabelStyle}" />
                                    <TextBlock x:Name="SelectedProductTotalValue"
                                               Text="R$ 0,00"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               Margin="0,8,10,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                    <Button x:Name="ProductSearchButton"
                                            Content="Buscar"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ProductSearchButton_Click"
                                            Margin="0,0,8,0" />
                                    <Button x:Name="AddItemButton"
                                            Content="Adicionar"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="AddItemButton_Click" />
                                </StackPanel>
                            </Grid>

                            <DataGrid Grid.Row="2"
                                      x:Name="ProductSearchResultsGrid"
                                      MaxHeight="180"
                                      Margin="0,0,0,10"
                                      MouseDoubleClick="ProductSearchResultsGrid_MouseDoubleClick"
                                      KeyDown="ProductSearchResultsGrid_KeyDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Codigo" Binding="{Binding DisplayCode}" Width="130" />
                                    <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Un" Binding="{Binding Unit}" Width="55" />
                                    <DataGridTextColumn Header="Preco" Binding="{Binding PriceText}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <DataGrid Grid.Row="3"
                                      x:Name="CartItemsGrid"
                                      VerticalAlignment="Stretch"
                                      Margin="0,0,0,10"
                                      KeyDown="CartItemsGrid_KeyDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="45" />
                                    <DataGridTextColumn Header="Codigo" Binding="{Binding DisplayCode}" Width="120" />
                                    <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Qtd" Binding="{Binding QuantityText}" Width="70" />
                                    <DataGridTextColumn Header="Unit." Binding="{Binding UnitPriceText}" Width="85" />
                                    <DataGridTextColumn Header="Desc." Binding="{Binding DiscountAmountText}" Width="85" />
                                    <DataGridTextColumn Header="Total" Binding="{Binding TotalAmountText}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mensagem" Style="{StaticResource LabelStyle}" />
                                    <TextBlock x:Name="OperationMessageValue"
                                               Text="-"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Subtotal" Style="{StaticResource LabelStyle}" />
                                    <TextBlock x:Name="SubtotalValue" Text="R$ 0,00" Style="{StaticResource ValueStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Total" Style="{StaticResource LabelStyle}" />
                                    <TextBlock x:Name="TotalValue"
                                               Text="R$ 0,00"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="26"
                                               FontWeight="Bold" />
                                </StackPanel>

                                <Button Grid.Column="3"
                                        x:Name="PaymentButton"
                                        Content="Pagamento (F10)"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="PaymentButton_Click"
                                        VerticalAlignment="Bottom"
                                        Padding="16,10"
                                        Margin="12,0,0,0" />
                            </Grid>
                        </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,10,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="OperatorStatusText"
                           DockPanel.Dock="Left"
                           Text="Operador: -"
                           Foreground="{DynamicResource TextPrimary}"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="0,0,18,0" />
                <TextBlock x:Name="CashStatusText"
                           DockPanel.Dock="Left"
                           Text="Caixa: fechado — F4 para abrir"
                           Foreground="{DynamicResource TextPrimary}"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="0,0,18,0" />
                <TextBlock x:Name="SyncStatusText"
                           DockPanel.Dock="Left"
                           Text="Sync: aguardando status"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="12"
                           Margin="0,0,18,0" />
                <TextBlock x:Name="ClockText"
                           DockPanel.Dock="Right"
                           Text=""
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="12" />
                <TextBlock x:Name="VersionText"
                           DockPanel.Dock="Right"
                           Text=""
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="12"
                           Margin="0,0,18,0" />
            </DockPanel>
        </Border>

        <TextBlock x:Name="LocalApiValue" Visibility="Collapsed" />
    </Grid>
</Window>
