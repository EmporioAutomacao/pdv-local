<Window x:Class="PdvLocal.App.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pagamento"
        Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfacePrimary}"
        Loaded="Window_Loaded"
        KeyDown="PaymentWindow_KeyDown">
    <Border Padding="28,24">
        <StackPanel>
            <TextBlock Text="Pagamento"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,10" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Total da venda" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="TotalValue"
                               Text="R$ 0,00"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="30"
                               FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Desconto total" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="SaleDiscountTextBox"
                             Style="{StaticResource InputStyle}"
                             Text="0,00"
                             TextChanged="SaleDiscountTextBox_TextChanged" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Cliente: CPF/CNPJ ou codigo (opcional)" Style="{StaticResource FieldLabelStyle}" />
            <DockPanel Margin="0,0,0,10" LastChildFill="True">
                <Button x:Name="CustomerSearchButton"
                        Content="&#x1F50D;"
                        DockPanel.Dock="Left"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="8,4"
                        Margin="0,0,8,8"
                        ToolTip="Pesquisar cliente na lista (nome, documento ou codigo)"
                        Click="CustomerSearchButton_Click" />
                <TextBlock x:Name="CustomerNameText"
                           DockPanel.Dock="Right"
                           Text=""
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           MaxWidth="200"
                           TextTrimming="CharacterEllipsis" />
                <TextBox x:Name="CustomerDocumentTextBox"
                         Style="{StaticResource InputStyle}"
                         KeyDown="CustomerDocumentTextBox_KeyDown"
                         LostFocus="CustomerDocumentTextBox_LostFocus" />
            </DockPanel>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Especie" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="PaymentMethodComboBox"
                              IsEditable="True"
                              DisplayMemberPath="DisplayName"
                              TextSearch.TextPath="Name"
                              Margin="0,0,0,8"
                              Padding="8,6" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Condicao" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="PaymentConditionComboBox"
                              IsEditable="True"
                              DisplayMemberPath="DisplayName"
                              TextSearch.TextPath="Name"
                              Margin="0,0,0,8"
                              Padding="8,6" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Valor recebido" Style="{StaticResource FieldLabelStyle}" />
            <DockPanel Margin="0,0,0,10" LastChildFill="True">
                <Button x:Name="RemovePaymentButton"
                        Content="Remover"
                        DockPanel.Dock="Right"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RemovePaymentButton_Click" />
                <Button x:Name="AddPaymentButton"
                        Content="Adicionar"
                        DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="AddPaymentButton_Click"
                        Margin="0,0,8,0" />
                <TextBox x:Name="PaymentReceivedTextBox"
                         Style="{StaticResource InputStyle}"
                         FontSize="18"
                         Text="0,00"
                         KeyDown="PaymentReceivedTextBox_KeyDown"
                         GotFocus="PaymentReceivedTextBox_GotFocus" />
            </DockPanel>

            <DataGrid x:Name="PaymentsGrid" MaxHeight="160" Margin="0,0,0,10" KeyDown="PaymentsGrid_KeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Especie" Binding="{Binding Method}" Width="*" />
                    <DataGridTextColumn Header="Condicao" Binding="{Binding Condition}" Width="95" />
                    <DataGridTextColumn Header="Aplicado" Binding="{Binding AmountText}" Width="82" />
                    <DataGridTextColumn Header="Troco" Binding="{Binding ChangeAmountText}" Width="72" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Pago" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="PaidValue" Text="R$ 0,00" Style="{StaticResource ValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Restante" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="RemainingValue" Text="R$ 0,00" Style="{StaticResource ValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Troco" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="ChangeValue"
                               Text="R$ 0,00"
                               Foreground="{DynamicResource SuccessText}"
                               FontSize="22"
                               FontWeight="Bold" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="PaymentMessageText"
                       Text=""
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"
                       Visibility="Collapsed" />

            <DockPanel LastChildFill="True">
                <Button x:Name="CancelPaymentButton"
                        Content="Voltar (Esc)"
                        DockPanel.Dock="Left"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0" />
                <Button x:Name="CompleteSaleButton"
                        Content="Concluir venda (F10)"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="CompleteSaleButton_Click"
                        Padding="12,10" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
