<Window x:Class="PdvLocal.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajuda — Atalhos e comportamentos"
        Width="640"
        Height="560"
        MinWidth="480"
        MinHeight="400"
        Background="#F8FAFC"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E40AF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <StackPanel>
                <TextBlock Text="Atalhos e referência rápida"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#0F172A" />
                <TextBlock Text="PDV Local — referência para operadores"
                           Foreground="#64748B"
                           FontSize="13"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- Conteúdo -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="18,10,18,10">
            <StackPanel>

                <!-- Atalhos globais -->
                <TextBlock Text="ATALHOS GLOBAIS (qualquer campo)" Style="{StaticResource SectionHeaderStyle}" Margin="0,6,0,4" />
                <DataGrid x:Name="GlobalShortcutsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserReorderColumns="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          BorderThickness="1"
                          BorderBrush="#E2E8F0"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFAFA"
                          HeadersVisibility="Column"
                          FontSize="13">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC" />
                            <Setter Property="Foreground" Value="#64748B" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="BorderBrush" Value="#E2E8F0" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tecla" Binding="{Binding Key}" Width="90" FontFamily="Consolas" />
                        <DataGridTextColumn Header="Condição" Binding="{Binding Condition}" Width="160" />
                        <DataGridTextColumn Header="Ação" Binding="{Binding Action}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Atalhos por campo -->
                <TextBlock Text="ATALHOS POR CAMPO" Style="{StaticResource SectionHeaderStyle}" />
                <DataGrid x:Name="FieldShortcutsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserReorderColumns="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          BorderThickness="1"
                          BorderBrush="#E2E8F0"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFAFA"
                          HeadersVisibility="Column"
                          FontSize="13">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC" />
                            <Setter Property="Foreground" Value="#64748B" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="BorderBrush" Value="#E2E8F0" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tecla" Binding="{Binding Key}" Width="90" FontFamily="Consolas" />
                        <DataGridTextColumn Header="Campo" Binding="{Binding Condition}" Width="160" />
                        <DataGridTextColumn Header="Ação" Binding="{Binding Action}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Sinais visuais -->
                <TextBlock Text="SINAIS VISUAIS" Style="{StaticResource SectionHeaderStyle}" />
                <DataGrid x:Name="VisualCuesGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserReorderColumns="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          BorderThickness="1"
                          BorderBrush="#E2E8F0"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFAFA"
                          HeadersVisibility="Column"
                          FontSize="13">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC" />
                            <Setter Property="Foreground" Value="#64748B" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="BorderBrush" Value="#E2E8F0" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Elemento" Binding="{Binding Key}" Width="200" />
                        <DataGridTextColumn Header="Sinal visual" Binding="{Binding Action}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Margin="0,14,0,4"
                           Foreground="#94A3B8"
                           FontSize="11"
                           Text="Dica: o supervisor pode ser autorizado uma única vez por turno. Após autorizado, informe apenas o Motivo em cada operação." />

            </StackPanel>
        </ScrollViewer>

        <!-- Botão fechar -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0"
                Padding="18,12">
            <Button Content="Fechar"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Right"
                    Click="CloseButton_Click"
                    IsCancel="True" />
        </Border>
    </Grid>
</Window>
