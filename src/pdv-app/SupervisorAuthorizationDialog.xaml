<Window x:Class="PdvLocal.App.SupervisorAuthorizationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autorizacao de supervisor"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfacePrimary}"
        Loaded="Window_Loaded">
    <Border Padding="32,28">
        <StackPanel>
            <TextBlock Text="Autorizacao de supervisor"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,4" />
            <TextBlock x:Name="OperationDescriptionText"
                       Text=""
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20" />

            <TextBlock Text="Login supervisor/admin" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:Name="SupervisorLoginTextBox"
                     Style="{StaticResource InputStyle}"
                     Margin="0,0,0,12" />

            <TextBlock Text="Senha" Style="{StaticResource FieldLabelStyle}" />
            <PasswordBox x:Name="SupervisorPasswordBox"
                         Background="{DynamicResource InputBg}"
                         Foreground="{DynamicResource InputFg}"
                         BorderBrush="{DynamicResource InputBorder}"
                         BorderThickness="1"
                         Padding="10,7"
                         Margin="0,0,0,12" />

            <TextBlock Text="Motivo" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:Name="SupervisorReasonTextBox"
                     Style="{StaticResource InputStyle}"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Height="58"
                     Margin="0,0,0,18" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelAuthorizationButton"
                        Content="Cancelar"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0" />
                <Button x:Name="AuthorizeSupervisorButton"
                        Content="Autorizar"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="AuthorizeSupervisorButton_Click" />
            </StackPanel>

            <TextBlock x:Name="AuthorizationErrorText"
                       Text=""
                       Foreground="#E53E3E"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>
