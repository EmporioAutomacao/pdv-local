<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fundos -->
    <SolidColorBrush x:Key="WindowBackground"     Color="#0F172A" />
    <SolidColorBrush x:Key="SurfacePrimary"       Color="#1E293B" />
    <SolidColorBrush x:Key="SurfaceSecondary"     Color="#162032" />
    <SolidColorBrush x:Key="SurfaceTertiary"      Color="#1E293B" />
    <SolidColorBrush x:Key="SurfaceAlt"           Color="#1A2540" />

    <!-- Texto -->
    <SolidColorBrush x:Key="TextPrimary"          Color="#F1F5F9" />
    <SolidColorBrush x:Key="TextSecondary"        Color="#94A3B8" />
    <SolidColorBrush x:Key="TextTertiary"         Color="#64748B" />
    <SolidColorBrush x:Key="TextOnAccent"         Color="White" />

    <!-- Bordas -->
    <SolidColorBrush x:Key="BorderPrimary"        Color="#334155" />
    <SolidColorBrush x:Key="BorderSecondary"      Color="#475569" />

    <!-- Acento / Banner -->
    <SolidColorBrush x:Key="AccentBg"             Color="#172554" />
    <SolidColorBrush x:Key="AccentBorder"         Color="#2563EB" />
    <SolidColorBrush x:Key="AccentText"           Color="#93C5FD" />

    <!-- Botao primario -->
    <SolidColorBrush x:Key="PrimaryBtnBg"         Color="#3B82F6" />
    <SolidColorBrush x:Key="PrimaryBtnBorder"     Color="#3B82F6" />
    <SolidColorBrush x:Key="PrimaryBtnFg"         Color="White" />

    <!-- Botao secundario -->
    <SolidColorBrush x:Key="SecondaryBtnBg"       Color="#1E293B" />
    <SolidColorBrush x:Key="SecondaryBtnBorder"   Color="#475569" />
    <SolidColorBrush x:Key="SecondaryBtnFg"       Color="#CBD5E1" />

    <!-- Botao perigo -->
    <SolidColorBrush x:Key="DangerBtnBg"          Color="#DC2626" />
    <SolidColorBrush x:Key="DangerBtnBorder"      Color="#DC2626" />
    <SolidColorBrush x:Key="DangerBtnFg"          Color="White" />

    <!-- Input -->
    <SolidColorBrush x:Key="InputBg"              Color="#0F172A" />
    <SolidColorBrush x:Key="InputBorder"          Color="#475569" />
    <SolidColorBrush x:Key="InputFg"              Color="#F1F5F9" />

    <!-- DataGrid -->
    <SolidColorBrush x:Key="GridLineBrush"        Color="#1E293B" />
    <SolidColorBrush x:Key="GridHeaderBg"         Color="#162032" />
    <SolidColorBrush x:Key="GridRowBg"            Color="#1E293B" />
    <SolidColorBrush x:Key="GridRowAltBg"         Color="#1A2540" />
    <SolidColorBrush x:Key="GridSelectionBg"      Color="#172554" />
    <SolidColorBrush x:Key="GridSelectionFg"      Color="#93C5FD" />

    <!-- Semanticos -->
    <SolidColorBrush x:Key="SuccessText"          Color="#4ADE80" />
    <SolidColorBrush x:Key="WarningText"          Color="#FCD34D" />
    <SolidColorBrush x:Key="WarningPanelBg"       Color="#1C1307" />
    <SolidColorBrush x:Key="WarningPanelBorder"   Color="#F59E0B" />
    <SolidColorBrush x:Key="ErrorText"            Color="#FCA5A5" />
    <SolidColorBrush x:Key="StatusText"           Color="#94A3B8" />

</ResourceDictionary>
