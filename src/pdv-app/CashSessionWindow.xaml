<Window x:Class="PdvLocal.App.CashSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caixa"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfacePrimary}"
        Loaded="Window_Loaded">
    <Border Padding="28,24">
        <StackPanel>
            <TextBlock Text="Caixa"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,4" />
            <TextBlock x:Name="CashOperatorText"
                       Text=""
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,18" />

            <StackPanel x:Name="OpenStatePanel">
                <TextBlock Text="Fundo de troco (abertura)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox x:Name="OpeningAmountTextBox"
                         Style="{StaticResource InputStyle}"
                         FontSize="18"
                         Text="0,00"
                         KeyDown="OpeningAmountTextBox_KeyDown"
                         Margin="0,0,0,14" />
                <Button x:Name="OpenCashButton"
                        Content="Abrir caixa"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OpenCashButton_Click"
                        HorizontalAlignment="Stretch"
                        Padding="12,10" />
            </StackPanel>

            <StackPanel x:Name="OpenedStatePanel">
                <TextBlock Text="Caixa atual" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock x:Name="CurrentCashSessionValue"
                           Text="-"
                           Foreground="{DynamicResource TextPrimary}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />

                <TextBlock Text="Resumo do caixa" Style="{StaticResource FieldLabelStyle}" />
                <DataGrid x:Name="CashSummaryGrid"
                          MaxHeight="170"
                          Margin="0,0,0,14"
                          IsTabStop="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item" Binding="{Binding Label}" Width="*" />
                        <DataGridTextColumn Header="Valor" Binding="{Binding ValueText}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Movimento de caixa" Style="{StaticResource FieldLabelStyle}" />
                <DockPanel Margin="0,0,0,8" LastChildFill="True">
                    <Button x:Name="CashWithdrawalButton"
                            Content="Sangria"
                            DockPanel.Dock="Right"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="CashWithdrawalButton_Click" />
                    <Button x:Name="CashSupplyButton"
                            Content="Suprimento"
                            DockPanel.Dock="Right"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CashSupplyButton_Click"
                            Margin="0,0,8,0" />
                    <TextBox x:Name="CashMovementAmountTextBox"
                             Style="{StaticResource InputStyle}"
                             Text="0,00" />
                </DockPanel>
                <TextBlock Text="Observacao do movimento (obrigatoria)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox x:Name="CashMovementObservationTextBox"
                         Style="{StaticResource InputStyle}"
                         Margin="0,0,0,14" />

                <TextBlock Text="Fechamento (contagem cega por especie)" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Text="Informe o valor contado de cada especie. O esperado e a diferenca aparecem no relatorio apos fechar."
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6" />
                <DataGrid x:Name="ClosingCountsGrid"
                          MaxHeight="170"
                          IsReadOnly="False"
                          Margin="0,0,0,14">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Especie" Binding="{Binding SpeciesName}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Contado" Binding="{Binding CountedText, UpdateSourceTrigger=PropertyChanged}" Width="130" IsReadOnly="False" />
                    </DataGrid.Columns>
                </DataGrid>
                <Button x:Name="CloseCashButton"
                        Content="Fechar caixa"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="CloseCashButton_Click"
                        HorizontalAlignment="Stretch"
                        Padding="12,10" />
            </StackPanel>

            <TextBlock x:Name="CashMessageText"
                       Text=""
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       Visibility="Collapsed" />

            <Button x:Name="CloseWindowButton"
                    Content="Voltar (Esc)"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0" />
        </StackPanel>
    </Border>
</Window>
