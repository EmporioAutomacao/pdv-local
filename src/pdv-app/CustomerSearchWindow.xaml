<Window x:Class="PdvLocal.App.CustomerSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pesquisar cliente"
        Width="560" Height="440"
        MinWidth="460" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfacePrimary}"
        Loaded="Window_Loaded">
    <Border Padding="24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Pesquisar cliente"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="Busque por nome, CPF/CNPJ ou codigo interno. Enter ou duplo clique seleciona."
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="True">
                <Button x:Name="CustomerQuerySearchButton"
                        Content="Buscar"
                        DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="CustomerQuerySearchButton_Click" />
                <TextBox x:Name="CustomerQueryTextBox"
                         Style="{StaticResource InputStyle}"
                         FontSize="16"
                         KeyDown="CustomerQueryTextBox_KeyDown" />
            </DockPanel>

            <DataGrid Grid.Row="2"
                      x:Name="CustomerResultsGrid"
                      Margin="0,0,0,12"
                      MouseDoubleClick="CustomerResultsGrid_MouseDoubleClick"
                      KeyDown="CustomerResultsGrid_KeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Codigo" Binding="{Binding CodeText}" Width="80" />
                    <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Documento" Binding="{Binding DocumentText}" Width="140" />
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="3" LastChildFill="True">
                <Button x:Name="CloseCustomerSearchButton"
                        Content="Cancelar (Esc)"
                        DockPanel.Dock="Right"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="8,0,0,0" />
                <Button x:Name="SelectCustomerButton"
                        Content="Selecionar"
                        DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="SelectCustomerButton_Click" />
                <TextBlock x:Name="CustomerSearchMessageText"
                           Text=""
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
