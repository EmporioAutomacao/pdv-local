<Window x:Class="PdvLocal.App.CashCloseReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PdvLocal.App"
        Title="Fechamento de caixa"
        Width="760" Height="640"
        MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfacePrimary}">
    <Window.Resources>
        <DataTemplate x:Key="LineRowTemplate" DataType="{x:Type local:ReportLineRow}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondary}" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="SpeciesRowTemplate" DataType="{x:Type local:ReportSpeciesRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding ExpectedText}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Grid.Column="2" Text="{Binding CountedText}" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Grid.Column="3" Text="{Binding DifferenceText}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{Binding DifferenceBrush}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="MovementRowTemplate" DataType="{x:Type local:ReportMovementRow}">
            <TextBlock Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap">
                <Run Text="{Binding TimeText, Mode=OneWay}" /> <Run Text="{Binding TypeText, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="{Binding AmountText, Mode=OneWay}" /> — <Run Text="{Binding Observation, Mode=OneWay}" />
            </TextBlock>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,14" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <RadioButton x:Name="A4FormatRadio" Content="A4" GroupName="ReportFormat" IsChecked="True"
                                 Foreground="{DynamicResource TextPrimary}" Margin="0,0,12,0" Checked="FormatRadio_Checked" />
                    <RadioButton x:Name="ThermalFormatRadio" Content="Termica (72mm)" GroupName="ReportFormat"
                                 Foreground="{DynamicResource TextPrimary}" Checked="FormatRadio_Checked" />
                </StackPanel>
                <TextBlock Text="Relatorio de fechamento de caixa"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,14">
            <Grid HorizontalAlignment="Center">
                <!-- Formato A4 -->
                <Border x:Name="A4Panel" Width="640" Background="White" Padding="32">
                    <StackPanel>
                        <TextBlock Text="FECHAMENTO DE CAIXA" FontSize="20" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" />
                        <TextBlock x:Name="A4HeaderText" Foreground="Black" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,6,0,14" TextAlignment="Center" />

                        <TextBlock Text="Resumo" FontWeight="Bold" Foreground="Black" Margin="0,0,0,4" />
                        <ItemsControl x:Name="A4SummaryItems" ItemTemplate="{StaticResource LineRowTemplate}" TextElement.Foreground="Black" Margin="0,0,0,14" />

                        <TextBlock Text="Conferencia por especie (esperado / contado / diferenca)" FontWeight="Bold" Foreground="Black" Margin="0,0,0,4" />
                        <ItemsControl x:Name="A4SpeciesItems" ItemTemplate="{StaticResource SpeciesRowTemplate}" Margin="0,0,0,14" />

                        <TextBlock Text="Suprimentos e sangrias" FontWeight="Bold" Foreground="Black" Margin="0,0,0,4" />
                        <ItemsControl x:Name="A4MovementItems" ItemTemplate="{StaticResource MovementRowTemplate}" Margin="0,0,0,14" />
                        <TextBlock x:Name="A4NoMovementsText" Text="Nenhum movimento registrado." Foreground="Black" FontStyle="Italic" Visibility="Collapsed" Margin="0,0,0,14" />

                        <TextBlock x:Name="A4FooterText" Foreground="Black" FontWeight="Bold" FontSize="14" />
                    </StackPanel>
                </Border>

                <!-- Formato termico ~72mm -->
                <Border x:Name="ThermalPanel" Width="272" Background="White" Padding="8" Visibility="Collapsed">
                    <StackPanel TextElement.FontFamily="Consolas" TextElement.FontSize="11">
                        <TextBlock Text="FECHAMENTO DE CAIXA" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ThermalHeaderText" Foreground="Black" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,8" />
                        <TextBlock Text="--------------------------------" Foreground="Black" HorizontalAlignment="Center" />
                        <ItemsControl x:Name="ThermalSummaryItems" ItemTemplate="{StaticResource LineRowTemplate}" Margin="0,4,0,4" />
                        <TextBlock Text="--------------------------------" Foreground="Black" HorizontalAlignment="Center" />
                        <TextBlock Text="ESPECIE  ESPER  CONT  DIF" Foreground="Black" FontWeight="Bold" Margin="0,4,0,2" />
                        <ItemsControl x:Name="ThermalSpeciesItems" Margin="0,0,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ReportSpeciesRow}">
                                    <TextBlock Foreground="Black" Text="{Binding ThermalLine, Mode=OneWay}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="--------------------------------" Foreground="Black" HorizontalAlignment="Center" />
                        <ItemsControl x:Name="ThermalMovementItems" Margin="0,4,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ReportMovementRow}">
                                    <TextBlock Foreground="Black" Text="{Binding ThermalLine, Mode=OneWay}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="--------------------------------" Foreground="Black" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ThermalFooterText" Foreground="Black" FontWeight="Bold" TextAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="20,12" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <Button Content="Fechar (Esc)"
                        DockPanel.Dock="Left"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button x:Name="PrintReportButton"
                        Content="Imprimir"
                        DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="PrintReportButton_Click" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
