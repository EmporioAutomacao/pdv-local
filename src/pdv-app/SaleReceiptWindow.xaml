<Window x:Class="PdvLocal.App.SaleReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comprovante de Venda"
        Width="420"
        SizeToContent="Height"
        MaxHeight="700"
        MinHeight="300"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ReceiptPanel" Margin="28,24,28,16">

                <!-- Cabecalho -->
                <TextBlock Text="PDV LOCAL"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#0F172A"
                           Margin="0,0,0,4" />
                <TextBlock x:Name="SaleNumberText"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Foreground="#334155"
                           FontWeight="SemiBold"
                           Margin="0,0,0,2" />
                <TextBlock x:Name="DateText"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="#64748B"
                           Margin="0,0,0,2" />
                <TextBlock x:Name="OperatorText"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="#64748B"
                           Margin="0,0,0,16" />

                <Rectangle Height="1" Fill="#CBD5E1" Margin="0,0,0,10" />

                <!-- Cabecalho das colunas de itens -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PRODUTO" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                    <TextBlock Grid.Column="1" Text="QTD" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" TextAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="UNIT." FontSize="11" FontWeight="SemiBold" Foreground="#64748B" TextAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="TOTAL" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" TextAlignment="Right" />
                </Grid>

                <!-- Itens da venda -->
                <ItemsControl x:Name="ItemsList" Margin="0,0,0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Foreground="#0F172A" />
                                    <TextBlock Text="{Binding DiscountLine}"
                                               FontSize="11"
                                               Foreground="#DC2626"
                                               Visibility="{Binding HasDiscount}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding QuantityText}"
                                           FontSize="13"
                                           TextAlignment="Right"
                                           Foreground="#334155" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding UnitPriceText}"
                                           FontSize="13"
                                           TextAlignment="Right"
                                           Foreground="#334155" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding TotalAmountText}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextAlignment="Right"
                                           Foreground="#0F172A" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Rectangle Height="1" Fill="#CBD5E1" Margin="0,0,0,10" />

                <!-- Totais -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Subtotal" FontSize="13" Foreground="#64748B" />
                    <TextBlock x:Name="SubtotalText" Grid.Column="1" FontSize="13" Foreground="#334155" TextAlignment="Right" />
                </Grid>

                <Grid x:Name="ItemDiscountRow" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Desc. itens" FontSize="13" Foreground="#DC2626" />
                    <TextBlock x:Name="ItemDiscountText" Grid.Column="1" FontSize="13" Foreground="#DC2626" TextAlignment="Right" />
                </Grid>

                <Grid x:Name="SaleDiscountRow" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Desc. total" FontSize="13" Foreground="#DC2626" />
                    <TextBlock x:Name="SaleDiscountText" Grid.Column="1" FontSize="13" Foreground="#DC2626" TextAlignment="Right" />
                </Grid>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="TOTAL" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock x:Name="TotalText" Grid.Column="1" FontSize="16" FontWeight="Bold" Foreground="#0F172A" TextAlignment="Right" />
                </Grid>

                <Rectangle Height="1" Fill="#CBD5E1" Margin="0,8,0,10" />

                <!-- Pagamentos -->
                <TextBlock Text="PAGAMENTOS" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6" />

                <ItemsControl x:Name="PaymentsList" Margin="0,0,0,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13" Foreground="#334155" />
                                <TextBlock Grid.Column="1" Text="{Binding AmountText}" FontSize="13" TextAlignment="Right" Foreground="#334155" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid x:Name="ChangeRow" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Troco" FontSize="14" FontWeight="SemiBold" Foreground="#166534" />
                    <TextBlock x:Name="ChangeText" Grid.Column="1" FontSize="14" FontWeight="SemiBold" Foreground="#166534" TextAlignment="Right" />
                </Grid>

                <Rectangle Height="1" Fill="#CBD5E1" Margin="0,14,0,12" />

                <!-- Rodape -->
                <TextBlock Text="Obrigado pela preferencia!"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="#64748B"
                           Margin="0,0,0,4" />
                <TextBlock x:Name="SyncStatusText"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Foreground="#94A3B8" />
            </StackPanel>
        </ScrollViewer>

        <!-- Botoes -->
        <Border Grid.Row="1"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0"
                Background="White"
                Padding="16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="PrintButton"
                        Content="Imprimir"
                        Click="PrintButton_Click"
                        Padding="16,8"
                        MinWidth="100"
                        Background="#2563EB"
                        Foreground="White"
                        BorderBrush="#2563EB"
                        Cursor="Hand"
                        Margin="0,0,10,0" />
                <Button x:Name="CloseButton"
                        Content="Fechar"
                        Click="CloseButton_Click"
                        Padding="16,8"
                        MinWidth="100"
                        Cursor="Hand" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
