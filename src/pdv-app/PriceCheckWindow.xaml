<Window x:Class="PdvLocal.App.PriceCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consulta de preco"
        Width="560" Height="480"
        MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfacePrimary}"
        Loaded="Window_Loaded">
    <Border Padding="24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Consulta de preco"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="Consulte o preco sem lancar o item na venda."
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="True">
                <Button x:Name="PriceSearchButton"
                        Content="Buscar"
                        DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="PriceSearchButton_Click" />
                <TextBox x:Name="PriceQueryTextBox"
                         Style="{StaticResource InputStyle}"
                         FontSize="18"
                         KeyDown="PriceQueryTextBox_KeyDown" />
            </DockPanel>

            <DataGrid Grid.Row="2"
                      x:Name="PriceResultsGrid"
                      Margin="0,0,0,12"
                      SelectionChanged="PriceResultsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Codigo" Binding="{Binding DisplayCode}" Width="130" />
                    <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Un" Binding="{Binding Unit}" Width="55" />
                    <DataGridTextColumn Header="Preco" Binding="{Binding PriceText}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="3" LastChildFill="True">
                <Button x:Name="ClosePriceCheckButton"
                        Content="Fechar (Esc)"
                        DockPanel.Dock="Right"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Bottom" />
                <StackPanel>
                    <TextBlock x:Name="PriceProductNameText"
                               Text="-"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="PriceValueText"
                               Text="R$ 0,00"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
