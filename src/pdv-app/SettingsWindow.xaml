<Window x:Class="PdvLocal.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações"
        Width="440"
        Height="320"
        MinWidth="360"
        MinHeight="260"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <StackPanel>
                <TextBlock Text="Configurações"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="Preferências do PDV Local"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="13"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- Conteúdo -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel>

                <!-- Seção: Aparência -->
                <TextBlock Text="APARÊNCIA"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,0,12" />

                <Border Background="{DynamicResource SurfacePrimary}"
                        BorderBrush="{DynamicResource BorderPrimary}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Tema"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal" >
                            <RadioButton x:Name="LightThemeRadio"
                                         Content="Claro"
                                         GroupName="Theme"
                                         Margin="0,0,24,0"
                                         Foreground="{DynamicResource TextPrimary}"
                                         Checked="ThemeRadio_Checked" />
                            <RadioButton x:Name="DarkThemeRadio"
                                         Content="Escuro"
                                         GroupName="Theme"
                                         Foreground="{DynamicResource TextPrimary}"
                                         Checked="ThemeRadio_Checked" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Seção: Venda -->
                <TextBlock Text="VENDA"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,20,0,12" />

                <Border Background="{DynamicResource SurfacePrimary}"
                        BorderBrush="{DynamicResource BorderPrimary}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Busca de produtos"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />
                        <CheckBox x:Name="ShowFactoryCodeCheckBox"
                                  Content="Exibir código de fábrica na busca de produtos"
                                  Foreground="{DynamicResource TextPrimary}"
                                  Checked="ShowFactoryCodeCheckBox_Changed"
                                  Unchecked="ShowFactoryCodeCheckBox_Changed" />
                    </StackPanel>
                </Border>

                <!-- Seção: Sistema -->
                <TextBlock Text="SISTEMA"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,20,0,12" />

                <Border Background="{DynamicResource SurfacePrimary}"
                        BorderBrush="{DynamicResource BorderPrimary}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Diagnóstico"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="Status do SyncAgent, banco local, ativação e atualizações."
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <Button x:Name="TechnicalDetailsButton"
                                Content="Diagnóstico e ativação"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="TechnicalDetailsButton_Click" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Rodapé -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Button Content="Fechar"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Right"
                    Width="96"
                    Click="CloseButton_Click"
                    IsCancel="True" />
        </Border>
    </Grid>
</Window>
