<Window x:Class="PdvLocal.App.UnitSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unidade de venda"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfacePrimary}"
        Loaded="Window_Loaded"
        KeyDown="UnitSelectionDialog_KeyDown">
    <Border Padding="24,20">
        <StackPanel>
            <TextBlock x:Name="ProductNameText"
                       Text="Produto"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4" />
            <TextBlock Text="Este produto tem mais de uma unidade de venda. Use as setas + Enter ou o numero da opcao."
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10" />

            <DataGrid x:Name="UnitsGrid"
                      MaxHeight="220"
                      Margin="0,0,0,12"
                      MouseDoubleClick="UnitsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding OptionNumber}" Width="36" />
                    <DataGridTextColumn Header="Un" Binding="{Binding Label}" Width="70" />
                    <DataGridTextColumn Header="Descricao" Binding="{Binding Description}" Width="*" />
                    <DataGridTextColumn Header="Preco" Binding="{Binding PriceText}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel LastChildFill="False">
                <Button Content="Cancelar (Esc)"
                        DockPanel.Dock="Left"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button x:Name="ConfirmUnitButton"
                        Content="Selecionar (Enter)"
                        DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="ConfirmUnitButton_Click" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
