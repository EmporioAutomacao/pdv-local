<Window x:Class="PdvLocal.App.SaleDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalhe da venda"
        Width="720" Height="600"
        MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="SaleStatusText"
                               DockPanel.Dock="Right"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="SaleNumberText"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" />
                </DockPanel>
                <TextBlock x:Name="SaleInfoText"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,12">
            <StackPanel>
                <TextBlock Text="Itens" Style="{StaticResource FieldLabelStyle}" />
                <DataGrid x:Name="ItemsGrid" MaxHeight="220" Margin="0,0,0,14">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="40" />
                        <DataGridTextColumn Header="Codigo" Binding="{Binding DisplayCode}" Width="110" />
                        <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Un" Binding="{Binding UnitText}" Width="50" />
                        <DataGridTextColumn Header="Qtd" Binding="{Binding QuantityText}" Width="60" />
                        <DataGridTextColumn Header="Unit." Binding="{Binding UnitPriceText}" Width="85" />
                        <DataGridTextColumn Header="Desc." Binding="{Binding DiscountAmountText}" Width="80" />
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalAmountText}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Pagamentos" Style="{StaticResource FieldLabelStyle}" />
                <DataGrid x:Name="PaymentsGrid" MaxHeight="160" Margin="0,0,0,14">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Especie" Binding="{Binding Method}" Width="*" />
                        <DataGridTextColumn Header="Valor" Binding="{Binding AmountText}" Width="95" />
                        <DataGridTextColumn Header="Parcelas" Binding="{Binding InstallmentsText}" Width="240" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceTertiary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="0,1,0,0"
                Padding="18,10">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="TotalsText"
                           DockPanel.Dock="Right"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock x:Name="DetailMessageText"
                           Foreground="{DynamicResource ErrorText}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </DockPanel>
        </Border>

        <Border Grid.Row="3"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="0,1,0,0"
                Padding="18,12">
            <DockPanel LastChildFill="False">
                <Button Content="Fechar (Esc)"
                        DockPanel.Dock="Left"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button x:Name="ReprintSaleButton"
                        Content="Reimprimir"
                        DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="ReprintSaleButton_Click"
                        Margin="8,0,0,0" />
                <Button x:Name="CancelSaleButton"
                        Content="Cancelar venda"
                        DockPanel.Dock="Right"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="CancelSaleButton_Click" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
