{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "SyncAgentDb": "Host=localhost;Port=55432;Database=pdv_sync;Username=pdv_sync;Password=pdv_sync"
  },
  "SyncAgent": {
    "InstanceId": "local-dev-agent-01",
    "ErpTenantId": "local-dev",
    "ErpApiBaseUrl": "https://localhost:5001",
    "AgentVersion": "0.1.0-dev",
    "PollingIntervalSeconds": 30,
    "LocalStatusPort": 47891
  },
  "Provisioning": {
    "Enabled": false,
    "ProtectedFile": ".secrets/sync-agent/provisioning.dpapi",
    "SetupHintFile": ".secrets/sync-agent/setup-hint.json",
    "ActivationTimeoutSeconds": 30
  },
  "ArpaCollector": {
    "Enabled": false,
    "LocalConnectionsProtectedFile": ".secrets/arpa/connections.dpapi",
    "ConnectionString": "",
    "PasswordEnvironmentVariable": "",
    "PasswordFile": "",
    "PasswordProtectedFile": "",
    "BatchSize": 100,
    "Entities": []
  },
  "ErpDispatcher": {
    "Enabled": false,
    "BatchSize": 50,
    "TimeoutSeconds": 30,
    "MaxAttempts": 8,
    "InitialBackoffSeconds": 60,
    "MaxBackoffSeconds": 3600,
    "InFlightRecoverySeconds": 900
  },
  "ErpHeartbeat": {
    "Enabled": false,
    "TimeoutSeconds": 15
  },
  "ErpReconciliation": {
    "Enabled": false,
    "TimeoutSeconds": 30
  },
  "ErpPdvSnapshot": {
    "Enabled": false,
    "TimeoutSeconds": 30,
    "Limit": 5000
  },
  "PdvSalesPublisher": {
    "Enabled": true,
    "BatchSize": 50
  },
  "ErpSecurity": {
    "AccessTokenEnvironmentVariable": "PDV_SYNC_ERP_ACCESS_TOKEN",
    "AccessToken": "",
    "ClientCertificateThumbprint": "",
    "ClientCertificateStoreName": "My",
    "ClientCertificateStoreLocation": "LocalMachine",
    "ClientCertificatePath": "",
    "ClientCertificatePasswordEnvironmentVariable": "PDV_SYNC_ERP_CERT_PASSWORD",
    "ClientCertificatePassword": "",
    "RequireBearerToken": true,
    "RequireMutualTls": true
  }
}
