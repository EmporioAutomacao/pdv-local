<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SyncAgent</RootNamespace>
    <AssemblyName>SyncAgent</AssemblyName>
    <Version>1.6.12</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Script unico e generico de views sync_export, rodado pelo botao "Preparar views". Fonte unica em infra/arpa/. -->
    <EmbeddedResource Include="..\..\infra\arpa\sync-export-views.sql">
      <LogicalName>SyncAgent.Arpa.sync-export-views.sql</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.*" />
    <PackageReference Include="Npgsql" Version="8.*" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.*" />
  </ItemGroup>
</Project>
