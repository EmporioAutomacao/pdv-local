<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\sync-agent\SyncAgent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- O instalador e WinExe/WinForms (net8.0-windows): so a logica pura de comparacao entra aqui. -->
    <Compile Include="..\..\src\sync-agent-installer\InstallVersionComparer.cs" Link="Installer\InstallVersionComparer.cs" />
  </ItemGroup>

</Project>
